# Database riêng của Việc cần xử lý (KHÔNG dùng chung với database của các hệ thống nguồn)
DATABASE_URL="postgresql://inbox:inbox@localhost:5432/inbox"

# Mã quản trị API (≥ 32 ký tự, ngẫu nhiên): đăng ký / sửa hệ thống nguồn qua /api/v1/systems.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INBOX_ADMIN_TOKEN=

# Đăng nhập — cùng cơ chế với hệ thống kho (xem README.md)
AUTH_AD_DOMAIN=fivestar
# Chỉ môi trường test (npm run dev:test / start:test): password dùng chung của hộp thoại đăng nhập
# TEST_LOGIN_CODE=
# Chỉ dev: tài khoản mặc định khi chưa chọn người dùng thử
# DEV_ACCOUNT=le.vanphuc
# SSO qua IIS (SSO_MODE=iis): mã bí mật dùng chung với IIS (≥ 32 ký tự)
# SSO_PROXY_SECRET=

PORT=3001

# Nhật ký hoạt động của API (file JSON Lines theo ngày); mặc định thư mục logs
# AUDIT_LOG_DIR=logs

# Khóa gốc (≥ 32 ký tự, ngẫu nhiên) để suy ra bí mật ký lời gọi xử lý gửi sang hệ thống nguồn (xem docs/api.md mục 7)
# INBOX_SIGNING_KEY=
